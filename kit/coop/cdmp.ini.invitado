; Crimson Desert Multiplayer - cooperativo (version de prueba) - INVITADO
[general]
; Tu nombre (lo ve el otro jugador)
player_name=Jugador
startup_delay_ms=0

[net]
enabled=1
; steam = por Steam, solo con amigos de Steam. udp = solo pruebas en este mismo PC (cdmp_peer)
transport=steam
; host = anfitrion (espera a su amigo); guest = invitado (se conecta al anfitrion)
role=guest
; Solo UDP: IP del anfitrion (el invitado) / puerto en el que escucha el anfitrion
peer_host=127.0.0.1
peer_port=37015
send_rate_hz=20

[steam]
; Invitado: SteamID64 del anfitrion (17 cifras). Vacio = el unico amigo que este
; jugando a Crimson Desert ahora mismo.
; Anfitrion: vacio = acepta a cualquier amigo que este jugando.
peer_steamid=

[overlay]
; Marcador con el nombre y la vida del otro jugador sobre su cabeza
enabled=1
self_marker=0
; Idioma de los textos del panel: en = ingles, es = espanol
; Language of the panel's texts: en = English, es = Spanish
language=es

[sniffer]
; Necesario para el cooperativo (lee y envia los mensajes internos del juego)
enabled=1
; 1 = ademas los graba en ficheros cdmp_packets_* (50-100 MB por sesion). Activado para la prueba:
; enviadnos esos ficheros junto con cdmp.log
record=1

[coop]
; Botin de los enemigos del anfitrion que ayudas a matar (experimental)
guest_loot=1
; 1 = el otro jugador aparece como un personaje en tu mundo
enabled=1
; Retardo de reproduccion en ms (mas = escaladas mas suaves, pero mas retraso)
delay_ms=200
; Desplazamiento lateral del otro jugador en metros (0 = posicion exacta)
offset_m=0
; El otro jugador se cambia el equipo como en su partida
equip=1
; Experimental: su caballo (monta y cabalga; al bajarse, su personaje se recarga en 1-2 s)
horse=1
; Dano "espejo" antiguo (golpes del otro a enemigos de su mundo -> enemigo parecido del tuyo).
; Apagado: ahora los enemigos se comparten (ver abajo)
damage=0
; El otro jugador en el minimapa y el mapa (M): flecha con borde
minimap_icon=0x124
; Marcador en el mapa cuando su personaje no esta cargado (por ejemplo, muy lejos)
map_pin=1
; ENEMIGOS COMPARTIDOS (experimental). El anfitrion manda: ves copias de SUS enemigos.
; El invitado NO pulsa Ctrl+F7. Tus propios enemigos no atacan a la copia del anfitrion
enemies_target_copy=0
; Tus golpes a las copias de los enemigos del anfitrion le llegan
guest_hits=1
guest_hit_stagger=1
; Tu personaje reacciona (tambaleo, derribo) a los golpes que los enemigos del otro dan a tu copia en su
; mundo, y puede morir por ellos (muerte normal, reapareces como siempre)
player_hit_react=1
player_hit_lethal=1
; (Solo cuenta en el anfitrion: cuantos enemigos a la vez atacan a la copia del otro)
copy_attack_slots=0
; Hora del dia: el invitado toma la del anfitrion (2 = tomar la del otro)
time_sync=2
; ZONA DE ENEMIGOS (fase 5, en pruebas). A menos de 150 m del anfitrion se ocultan TUS enemigos
; hostiles y ves solo las copias de los del anfitrion; a mas de 250 m vuelven los tuyos.
; dry = solo apunta en cdmp.log lo que ocultaria (no cambia nada); 1 = activado; 0 = apagado.
; Se queda en dry hasta probarlo (docs/PRUEBA-DOS-PC.md, seccion E): para probarlo pon 1
suppress=dry
suppress_radius_m=150
suppress_off_m=250
; Si el anfitrion muere y reaparece lejos, la zona se mantiene estos segundos (0 = no)
suppress_respawn_grace_s=60
; 1 = al salir de la zona vuelven tus enemigos (los que tu servidor sigue teniendo)
suppress_restore=1
; Segundos que se espera a que acabe una pelea con tus enemigos antes de ocultarlos
suppress_wait_fight_s=60
; 1 = tambien los eventos de nodo y de faccion (refuerzos, eventos diarios)
suppress_node_events=0

[dev]
; El arbol del que tira el otro jugador se dobla tambien aqui (experimental)
rope_bend=1
; Cuerda en arboles: busca la pieza del arbol en este PC (experimental)
rope_piece_lookup=1
; Solo el anfitrion envia sus enemigos
enemy_relay=0
